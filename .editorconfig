root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,json,jsonc,yml,yaml,css,scss}]
indent_size = 2

[*.md]
indent_size = 2
# Trailing whitespace is not meaningful in our Markdown, so it is trimmed.

[Makefile]
indent_style = tab

[*.sql]
indent_size = 4
