# Ports are non-default throughout so nothing collides with a local install.

# Postgres
POSTGRES_DB=bazaarwatch
POSTGRES_USER=bazaarwatch
# No default. Compose refuses to start without it, which is preferable to a
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

# Composed from the above. Kept explicit so it can be pointed elsewhere.
DATABASE_URL=postgresql+psycopg://bazaarwatch:CHANGEME@localhost:55432/bazaarwatch


# Redis
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379/0


# Application ports
API_PORT=58000
CONSOLE_PORT=53000
WEB_PORT=53001
